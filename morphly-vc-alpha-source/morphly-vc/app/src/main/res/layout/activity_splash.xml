<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/white">
    <View android:layout_width="match_parent" android:layout_height="10dp" android:background="@color/brand"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="112dp" android:layout_height="112dp"
            android:src="@drawable/ic_morphly_mark" android:contentDescription="Morphly logo"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Morphly" android:textSize="36sp"
            android:textColor="@color/brand" android:textStyle="bold"/>
        <ProgressBar android:layout_width="174dp" android:layout_height="4dp"
            android:layout_marginTop="36dp" android:indeterminate="true"
            android:indeterminateTint="@color/brand" style="?android:attr/progressBarStyleHorizontal"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="G e t t i n g   t h i n g s   r e a d y . . ."
            android:textSize="11sp" android:textColor="@color/muted" />
    </LinearLayout>
</LinearLayout>
